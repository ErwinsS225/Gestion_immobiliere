NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Reglements -------------------------------------------------------------
# L application fonctionne entierement en simulation tant que cette variable
# reste absente ou vaut simulation : aucun appel ne sort de l application.
#
# Pour passer en reel :
#   1. NEXT_PUBLIC_PAYMENT_MODE=live
#   2. renseigner PAYMENT_API_URL et PAYMENT_API_KEY
#   3. renseigner PAYMENT_WEBHOOK_SECRET pour verifier les webhooks entrants
#
# Aucun code n a besoin d etre modifie : le point de bascule est
# lib/payments/gateway.ts.
NEXT_PUBLIC_PAYMENT_MODE=simulation
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=